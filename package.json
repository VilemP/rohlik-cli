{
  "name": "@tomaspavlin/rohlik-cli",
  "version": "4.0.0",
  "type": "module",
  "description": "CLI for Rohlik Group grocery services - search products, manage cart, view orders",
  "keywords": [
    "rohlik",
    "grocery",
    "shopping",
    "cli",
    "bun"
  ],
  "author": "Tomas Pavlin",
  "license": "MIT",
  "main": "src/cli.ts",
  "bin": {
    "rohlik": "src/cli.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "SKILL.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomaspavlin/rohlik-cli.git"
  },
  "bugs": {
    "url": "https://github.com/tomaspavlin/rohlik-cli/issues"
  },
  "homepage": "https://github.com/tomaspavlin/rohlik-cli#readme",
  "scripts": {
    "rohlik": "bun run src/cli.ts",
    "start": "bun run src/cli.ts",
    "dev": "bun --watch src/cli.ts",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "picocolors": "^1.1.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
